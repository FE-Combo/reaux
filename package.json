{
  "private": true,
  "name": "reaux",
  "description": "Front-End application framework base on react an redux",
  "scripts": {
    "reinstall": "rm -rf node_modules && rm -rf pnpm-lock.yaml && pnpm install",
    "start:dom": "pnpm --filter dom dev",
    "start:ios": "pnpm --filter native ios",
    "start:android": "pnpm --filter native android",
    "clean": "pnpm -r exec rm -rf node_modules",
    "eslint": "eslint . --fix",
    "build": "node scripts/build.js",
    "jest": "jest --config config/jest.json --coverage",
    "format": "prettier --config config/prettier.json --write \"packages/**/*.{ts,tsx}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(tsx|ts)": [
      "pnpm eslint",
      "pnpm format"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FE-Combo/reaux.git"
  },
  "keywords": [
    "javascript",
    "typescript"
  ],
  "author": "Zed",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FE-Combo/reaux/issues"
  },
  "homepage": "https://github.com/FE-Combo/reaux#readme",
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/jest": "~29.2.0",
    "@types/node": "~18.11.2",
    "@types/react-test-renderer": "~18.0.0",
    "@typescript-eslint/eslint-plugin": "~5.40.1",
    "@typescript-eslint/parser": "~5.40.1",
    "babel-jest": "~29.2.1",
    "chalk": "~4.1.2",
    "codecov": "~3.8.3",
    "eslint": "~8.25.0",
    "eslint-plugin-prettier": "~4.2.1",
    "eslint-plugin-react": "~7.31.10",
    "eslint-plugin-react-hooks": "~4.6.0",
    "fs-extra": "~10.1.0",
    "husky": "~9.1.7",
    "jest": "~29.2.1",
    "lint-staged": "^16.2.7",
    "prettier": "~2.7.1",
    "react-test-renderer": "~18.2.0",
    "ts-jest": "~29.0.3",
    "ts-node": "~10.9.1",
    "tslib": "~2.4.0",
    "typescript": "~4.8.4"
  }
}
